<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="UTF-8">
    <title>Inregistrare Cont</title>
</head>
<body>
    <h1>Creeaza un cont nou</h1>

    <% if (error) { %>
        <p style="color: red;"><%= error %></p>
    <% } %>

    <form action="/register" method="POST">
        <label>Nume Utilizator (Username):</label><br>
        <input type="text" name="username" required><br><br>

        <label>Adresa Email:</label><br>
        <input type="email" name="email" required><br><br>

        <label>Parola (Min 6 caractere):</label><br>
        <input type="password" name="password" required><br><br>

        <button type="submit">Inregistrare</button>
    </form>
    <p>Ai deja cont? <a href="/login">Logheaza-te aici</a></p>
</body>
</html>